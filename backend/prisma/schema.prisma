generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CENTRE
  DISTRICT_OFFICER
  QUALITY
  STATE
}

enum BatchStatus {
  DRAFT
  DISTRICT_REVIEW
  QUALITY_REVIEW
  STATE_REVIEW
  SENT_BACK
  REJECTED
  APPROVED
}

enum ReviewStage {
  DISTRICT
  QUALITY
  STATE
}

enum ReviewDecision {
  APPROVE
  SEND_BACK
  REJECT
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model District {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  centres TrainingCentre[]
  users   User[]

  @@map("districts")
}

model TrainingCentre {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  districtId Int      @map("district_id")
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  batches    Batch[]

  @@map("training_centres")
}

model User {
  id         Int             @id @default(autoincrement())
  username   String          @unique
  name       String
  role       Role
  districtId Int?            @map("district_id")
  district   District?       @relation(fields: [districtId], references: [id])
  centreId   Int?            @map("centre_id")
  centre     TrainingCentre? @relation(fields: [centreId], references: [id])
  reviews    BatchReview[]
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("users")
}

model Batch {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  centreId       Int           @map("centre_id")
  centre         TrainingCentre @relation(fields: [centreId], references: [id])
  courseCode     String        @map("course_code")
  courseName     String        @map("course_name")
  status         BatchStatus   @default(DRAFT)
  // Bumped every time a sent-back batch is resubmitted. Reviews belong to one revision.
  revision       Int           @default(1)
  stageEnteredAt DateTime      @default(now()) @map("stage_entered_at")
  escalatedAt    DateTime?     @map("escalated_at")
  sendBackReason String?       @map("send_back_reason")
  submittedAt    DateTime?     @map("submitted_at")
  approvedAt     DateTime?     @map("approved_at")
  createdById    Int           @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  candidates     Candidate[]
  reviews        BatchReview[]
  certificates   Certificate[]

  @@index([status, stageEnteredAt])
  @@index([centreId])
  @@map("batches")
}

model Candidate {
  id           String       @id @default(uuid()) @db.Uuid
  batchId      String       @map("batch_id") @db.Uuid
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber    Int          @map("row_number")
  enrolmentId  String       @map("enrolment_id")
  name         String
  phone        String
  score        Int
  certificate  Certificate?

  @@unique([batchId, enrolmentId])
  @@unique([batchId, phone])
  @@map("candidates")
}

model BatchReview {
  id         String         @id @default(uuid()) @db.Uuid
  batchId    String         @map("batch_id") @db.Uuid
  batch      Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  revision   Int
  stage      ReviewStage
  reviewerId Int            @map("reviewer_id")
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at")

  // One officer can act once per stage per revision: double clicks and replays fail here.
  @@unique([batchId, revision, stage, reviewerId])
  @@map("batch_reviews")
}

model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  certificateNo     String            @unique @map("certificate_no")
  // At most one certificate per candidate, enforced by the database.
  candidateId       String            @unique @map("candidate_id") @db.Uuid
  candidate         Candidate         @relation(fields: [candidateId], references: [id])
  batchId           String            @map("batch_id") @db.Uuid
  batch             Batch             @relation(fields: [batchId], references: [id])
  // Snapshot at issue time: a certificate never changes after it is issued.
  candidateName     String            @map("candidate_name")
  phone             String
  enrolmentId       String            @map("enrolment_id")
  courseCode        String            @map("course_code")
  courseName        String            @map("course_name")
  centreName        String            @map("centre_name")
  issuedAt          DateTime          @default(now()) @map("issued_at")
  status            CertificateStatus @default(ISSUED)
  revokedAt         DateTime?         @map("revoked_at")
  revokedById       Int?              @map("revoked_by_id")
  revokeReason      String?           @map("revoke_reason")
  pdfPath           String?           @map("pdf_path")
  deliveryStatus    DeliveryStatus    @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int               @default(0) @map("delivery_attempts")
  deliveredAt       DateTime?         @map("delivered_at")
  providerMessageId String?           @map("provider_message_id")
  lastDeliveryError String?           @map("last_delivery_error")

  @@index([batchId])
  // Also enforced in SQL (migration 20261121070000): a partial unique index
  //   UNIQUE (enrolment_id, course_code) WHERE status = 'ISSUED'
  // = one person can hold at most one valid certificate per course. Prisma cannot express
  // partial indexes, so it lives in the migration only.
  @@map("certificates")
}

// Append-only record of every decision and side effect.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actorId       Int?     @map("actor_id")
  actorRole     String?  @map("actor_role")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  batchId       String?  @map("batch_id") @db.Uuid
  metadata      Json     @default("{}")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([batchId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Transactional outbox: events are written in the same transaction as the state change
// and relayed to the queue afterwards, so an event is never lost or sent for a rolled-back change.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
