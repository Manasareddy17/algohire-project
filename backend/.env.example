# Local development against `docker compose up postgres redis mock-whatsapp`
DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-dev-jwt-secret-change-me
DOWNLOAD_TOKEN_SECRET=local-dev-download-secret-change-me
PUBLIC_BASE_URL=http://localhost:5173
WHATSAPP_API_URL=http://localhost:4001
CERTIFICATE_STORAGE_DIR=./storage/certificates
QUALITY_REVIEW_THRESHOLD=50
DISTRICT_APPROVALS_REQUIRED=2
SLA_MINUTES=5
LOG_LEVEL=debug
